using "ui/colors.palette";
using "ui/chat/chat.style";
using "ui/widgets/widgets.style";
using "dialogs/dialogs.style";

enderGhostIcon: icon {{ "ender/ghost", menuIconColor }};
enderGhostModeGlobalIcon: icon {{ "ender/ghost_mode_global", historyPeerUserpicFg }};
enderEditsHistoryIcon: icon {{ "ender/edits_history", menuIconColor }};
enderLReadMenuIcon: icon {{ "ender/lread", menuIconColor }};
enderSReadMenuIcon: icon {{ "ender/sread", menuIconColor }};
enderStreamerModeMenuIcon: icon {{ "ender/streamer", menuIconColor }};
enderToBeginningMenuIcon: icon {{ "ender/to_beginning", menuIconColor }};
enderRepeatMenuIcon: icon {{ "ender/repeat", menuIconColor }};
enderContactsMutualIcon: icon {{ "ender/contacts_mutual", contactsStatusFg }};
enderContactsMutualIconOver: icon {{ "ender/contacts_mutual", contactsStatusFgOver }};

messageFieldAttachIcon: icon {{ "ender/message_field/attach", menuIconColor }};
messageFieldCommandsIcon: icon {{ "ender/message_field/commands", menuIconColor }};
messageFieldEmojiIcon: icon {{ "ender/message_field/emoji", menuIconColor }};
messageFieldVoiceIcon: icon {{ "ender/message_field/voice", menuIconColor }};
messageFieldTTLIcon: icon {{ "ender/message_field/ttl", menuIconColor }};
messageFieldCocoonAiIcon: icon{
	{ size(24px, 24px), transparent },
	{ "chat/ai_letters-20x20", menuIconColor, point(2px, 2px) },
	{ "chat/ai_star1-20x20", menuIconColor, point(2px, 2px) },
	{ "chat/ai_star2-20x20", menuIconColor, point(2px, 2px) },
};

inChannelBadgeIcon: icon {{ "ender/channel", msgInDateFg }};
inChannelBadgeSelectedIcon: icon {{ "ender/channel", msgInDateFgSelected }};
outChannelBadgeIcon: icon {{ "ender/channel", msgOutDateFg }};
outChannelBadgeSelectedIcon: icon {{ "ender/channel", msgOutDateFgSelected }};

infoExteraOfficialBadge: icon {{ "ender/extera_official", profileVerifiedCheckBg }};
infoExteraSupporterBadge: icon {{ "ender/extera_badge", profileVerifiedCheckBg }};

winEnterWithGuestIcon: icon {{ "ender/ghost_tray", windowFg }};

editedIcon: IconEmoji{
    icon: icon{{ "ender/edited", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

deletedIcon: IconEmoji{
    icon: icon{{ "ender/trash_bin", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

burntIcon: IconEmoji{
    icon: icon{{ "ender/burnt", windowFg }};
    padding: margins(0px, 0px, 0px, 0px);
    useIconColor: false;
}

dialogsExteraOfficialIcon: ThreeStateIcon {
	icon: icon {{ "ender/dialogs_extera_official", dialogsVerifiedIconBg }};
	over: icon {{ "ender/dialogs_extera_official", dialogsVerifiedIconBgOver }};
	active: icon {{ "ender/dialogs_extera_official", dialogsVerifiedIconBgActive }};
}
dialogsExteraSupporterIcon: ThreeStateIcon {
	icon: icon {{ "ender/dialogs_extera_supporter", dialogsVerifiedIconBg }};
	over: icon {{ "ender/dialogs_extera_supporter", dialogsVerifiedIconBgOver }};
	active: icon {{ "ender/dialogs_extera_supporter", dialogsVerifiedIconBgActive }};
}

enderHistoryFileInPlugin: icon {{ "ender/history_file_plugin", historyFileInIconFg }};
enderHistoryFileInPluginSelected: icon {{ "ender/history_file_plugin", historyFileInIconFgSelected }};
enderHistoryFileOutPlugin: icon {{ "ender/history_file_plugin", historyFileOutIconFg }};
enderHistoryFileOutPluginSelected: icon {{ "ender/history_file_plugin", historyFileOutIconFgSelected }};

menuIconClearAttention: icon {{ "menu/clear", menuIconAttentionColor }};
